```{r load_labels, eval=do_labels, include=FALSE}
assert_that(all(sapply(label_f_ls, file.exists)))
guesses_ls = lapply(label_f_ls, fread) %>% setNames(model_ls)
styles_ls = lapply(seq_along(model_ls), function(i)
  resolve_label_style(NULL, character(), label_specs_f_ls[[i]], coarse_label_specs_f_ls[[i]]))
for (i in seq_along(guesses_ls)) {
  mapping = styles_ls[[i]]$mapping
  if (!length(mapping)) next
  for (suffix in c("naive","agg")) {
    original = guesses_ls[[i]][[paste0("predicted_label_",suffix)]]
    value = unname(mapping[original])
    value[is.na(value)] = original[is.na(value)]
    set(guesses_ls[[i]], j=paste0("coarse_predicted_label_",suffix), value=value)
  }
}
```

```{r plot_labels_heatmap, eval=do_labels, include=do_labels, fig.height=12, fig.width=13, results="asis"}
cat("### Raw labels versus clusters and projects{.tabset}\n\n")
cat("Labels that are assigned to less than 20% of cells in any cluster are combined into a single `Other` class.\n\n")

comparison_vars = c(paste0('RNA_snn_res.', sel_res), 'project_id')
comparison_titles = c(paste('Clusters (resolution', paste0(sel_res, ')')), 'Projects')
for (jj in seq_along(comparison_vars)) {
  cat('####', comparison_titles[[jj]], '{.tabset}\n\n')
  for (ii in seq_along(label_f_ls)) {
    cat('#####', labeller_ls[[ii]], ',', model_ls[[ii]], '{.tabset}\n\n')
    views = get_label_views(guesses_ls[[ii]], styles_ls[[ii]])
    # a Labels/Grouped labels sub-tab is only inserted when there is a coarse
    # view to show; otherwise the normalization tabs stay directly below
    view_level = if (length(views) > 1) 6 else 5
    for (view_name in names(views)) {
      cat_label_view_tab(view_name, views, level = 5)
      confuse_dt = prepare_join_label_comparison(views[[view_name]]$labels_dt, int_dt,
        comparison_vars[[jj]], min_cl2_p = min_cl2_p)
      for (normalization in c('column', 'row')) {
        view_title = if (normalization == 'row') 'Within cell types (rows sum to 1)'
          else if (comparison_vars[[jj]] == 'project_id') 'Within projects (columns sum to 1)'
          else 'Within clusters (columns sum to 1)'
        cat(strrep('#', view_level + 1), ' ', view_title, '\n\n', sep = '')
        draw(plot_join_label_comparison(confuse_dt, model_ls[[ii]],
          comparison_titles[[jj]], normalization, lbl_threshold), merge_legend = TRUE)
        cat('\n\n')
      }
    }
  }
}
```

```{r plot_labels_umap, eval=do_labels, include=do_labels, fig.height=5, fig.width=12, results="asis"}
cat("### Aggregated cell-type predictions over UMAP{.tabset}\n\n")

for (ii in seq_along(label_f_ls)) {
  this_labeller  = labeller_ls[[ii]]
  this_model     = model_ls[[ii]]
  this_hi_res_cl = hi_res_cl_ls[[ii]]

  int_tmp = int_dt[, .(cell_id, UMAP1, UMAP2,
    hi_res_cl = get(this_hi_res_cl) %>% fct_infreq)]
  g_cl = plot_umap_labels(int_dt,
    int_tmp[, .(cell_id, cluster = hi_res_cl)], "high resolution\ncluster")

  views = get_label_views(guesses_ls[[ii]], styles_ls[[ii]])
  cat_label_views_heading(paste0(this_labeller, ', ', this_model), views, level = 4)
  for (view_name in names(views)) {
    cat_label_view_tab(view_name, views, level = 4)
    view   = views[[view_name]]
    g_pred = plot_umap_labels(int_dt, view$labels_dt[, .(cell_id, cluster = predicted_label_agg)],
      "prediction\n(aggregated)", label_order = view$order, label_colours = view$colours)
    print(g_cl + g_pred)
    cat('\n\n')
  }
}
```

```{r tbl_labels, eval=do_labels, include=do_labels, results="asis"}
library(kableExtra)
cat("### Totals for each predicted cell type{.tabset}\n\n")

for (ii in seq_along(label_f_ls)) {
  this_labeller = labeller_ls[[ii]]
  this_model    = model_ls[[ii]]

  views = get_label_views(guesses_ls[[ii]], styles_ls[[ii]])
  cat_label_views_heading(paste0(this_labeller, ', ', this_model), views, level = 4)
  for (view_name in names(views)) {
    cat_label_view_tab(view_name, views, level = 4)
    view = views[[view_name]]
    view$labels_dt %>% calc_labels_table(label_order = view$order) %>% kbl("html") %>%
      row_spec(row = 0, bold = TRUE) %>%
      kable_styling(bootstrap_options = "striped", full_width = FALSE,
        font_size = 12, position = "center") %>%
      scroll_box(width = "60%", height = "500px") %>% print
    cat('\n\n')
  }
}
```

