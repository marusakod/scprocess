```{r setup_input, include=FALSE}
join_name     = "${join_name}"
join_tag      = "${join_tag}"
join_int_dir  = "${join_int_dir}"
join_mkr_dir  = "${join_mkr_dir}"
ref_txome     = "${ref_txome}"
sel_res       = "${mkr_sel_res}"
res_ls        = "${int_res_ls}" %>% str_split(pattern = ' ') %>% unlist() %>% as.numeric()

not_ok_re     = "(lincRNA|lncRNA|pseudogene|antisense)"
min_cpm_mkr   = ${mkr_min_cpm_mkr}
min_cells     = ${mkr_min_cells}
gsea_cut      = ${mkr_gsea_cut}
gsea_var_sel  = "z_score"

# input file paths
integration_f = "${integration_f}"
qc_f          = "${qc_f}"
sample_meta_f = "${sample_meta_f}"
mkrs_f        = "${mkrs_f}"
pb_hvgs_f     = "${pb_hvgs_f}"
pb_plot_data_f = "${pb_plot_data_f}"
fgsea_go_bp_f = "${fgsea_go_bp_f}"
fgsea_go_cc_f = "${fgsea_go_cc_f}"
fgsea_go_mf_f = "${fgsea_go_mf_f}"

do_gsea       = all(nzchar(c(fgsea_go_bp_f, fgsea_go_cc_f, fgsea_go_mf_f)))

# xgboost files
xgb_predictions_f = "${xgb_predictions_f}"
xgb_importance_f  = "${xgb_importance_f}"
xgb_pseudobulk_f  = "${xgb_pseudobulk_f}"
xgb_has_coarse    = as.logical("${xgb_has_coarse}")
xgb_min_cells     = as.integer("${xgb_min_cells}")

# custom markers for heatmap
custom_mkr_names_str = "${custom_mkr_names}"
custom_mkr_paths_str = "${custom_mkr_paths}"
if (custom_mkr_names_str != "") {
  custom_mkr_names = str_split(custom_mkr_names_str, pattern = ',') %>% unlist()
  custom_mkr_paths = str_split(custom_mkr_paths_str, pattern = ',') %>% unlist() %>%
    setNames(custom_mkr_names)
}

# cell type labeling
label_f_ls_str    = "${label_f_ls}"
labeller_ls_str   = "${labeller_ls}"
model_ls_str      = "${model_ls}"
hi_res_cl_ls_str  = "${hi_res_cl_ls}"
min_cl_prop_ls_str = "${min_cl_prop_ls}"
do_labels = label_f_ls_str != ""
if (do_labels) {
  label_f_ls     = str_split(label_f_ls_str, " ")[[1]]
  labeller_ls    = str_split(labeller_ls_str, " ")[[1]]
  model_ls       = str_split(model_ls_str, " ")[[1]]
  hi_res_cl_ls   = str_split(hi_res_cl_ls_str, " ")[[1]]
  min_cl_prop_ls = str_split(min_cl_prop_ls_str, " ")[[1]] %>% as.numeric()
  min_cl2_p      = 0.05
  lbl_threshold  = 0.05
}

cl_ord        = NULL
```


```{r load_integration, include=FALSE}
int_all = fread(integration_f)
int_dt  = int_all[ !is.na(UMAP1) ] %>%
  .[, c("sample_id", "project_id", "cell_id", "embedding", "UMAP1", "UMAP2",
    str_subset(names(int_all), "RNA_snn_res")), with = FALSE]
```


```{r load_metadata, include=FALSE}
meta_dt   = fread(sample_meta_f)
```


```{r load_qc, include=FALSE}
qc_names = c('log_counts', 'log_feats', 'logit_mito', 'logit_spliced', 'doublet_score')
qc_lu = c('no. of UMIs', 'no. of genes', 'mito pct.', 'spliced pct.', 'doublet score') %>%
  setNames(qc_names)
qc_dt = fread(qc_f)
qc_names = intersect(qc_names, names(qc_dt))
assert_that(length(qc_names) > 0)
qc_melt = melt(qc_dt, id.vars = 'cell_id', measure.vars = qc_names,
  value.name = 'qc_val', variable.name = 'qc_var') %>%
  .[, qc_full := qc_lu[qc_var]] %>%
  .[, qc_var := factor(qc_var, levels = qc_names)] %>%
  .[, qc_full := fct_reorder(qc_full, as.integer(qc_var))] %>%
  .[!is.na(qc_val)]
```


```{r setup_sel_res, include=FALSE}
cfg_metadata_vars = "${metadata_vars}" %>% str_split(" ") %>% unlist() %>% trimws()
cfg_metadata_vars = cfg_metadata_vars[cfg_metadata_vars != ""]
metadata_vars = intersect(cfg_metadata_vars, names(meta_dt))
composition_vars = unique(c('project_id', metadata_vars))

sel_cl_int_dt = copy(int_dt) %>%
  .[, cluster := get(paste0("RNA_snn_res.", sel_res)) %>% fct_infreq ] %>%
  .[, .(sample_id, project_id, cell_id, UMAP1, UMAP2, cluster)]
if (length(metadata_vars) > 0) {
  meta_cols = intersect(c("sample_id", metadata_vars), names(meta_dt))
  sel_cl_int_dt = merge(sel_cl_int_dt, unique(meta_dt[, meta_cols, with = FALSE]),
    by = "sample_id", all.x = TRUE)
}
```


```{r load_gene_biotypes, include=FALSE}
sel_ref_txome = ref_txome
idx_params  = Sys.getenv('SCPROCESS_DATA_DIR') %>%
  file.path('index_parameters.csv') %>% fread
gtf_dt_f    = idx_params[reference == sel_ref_txome, gene_info_f][1]
biotypes_dt = load_gene_biotypes(gtf_dt_f)
```


```{r load_cpms, include=FALSE}
cpms_dt = fread(pb_plot_data_f)
```


```{r load_hvgs, include=FALSE}
pb_hvgs_dt = fread(pb_hvgs_f) %>%
  .[ str_detect(gene_type, not_ok_re, negate = TRUE) ] %>%
  .[ order(-logcpm_var) ]
top_hvgs = pb_hvgs_dt[ 1:50 ] %>% .[, geneset := "HVGs"]
```


```{r load_markers, include=FALSE}
mkrs_dt     = fread(mkrs_f)
if (is.null(cl_ord))
  cl_ord      = levels(sel_cl_int_dt$cluster) %>% intersect(unique(mkrs_dt$cluster))

mkrs_ls = list(HVGs = top_hvgs)
if (custom_mkr_names_str != "") {
  custom_mkrs_dt_ls = lapply(custom_mkr_paths, FUN = process_custom_markers,
    biotypes_dt = biotypes_dt, hvgs_dt = pb_hvgs_dt, marker_calcs_dt = mkrs_dt)
  custom_mkrs_dt_ls = Filter(Negate(is.null), custom_mkrs_dt_ls)
  mkrs_ls = c(custom_mkrs_dt_ls, mkrs_ls)
