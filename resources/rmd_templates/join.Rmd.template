```{r plot_labels_heatmap, eval=do_labels, include=do_labels, fig.height=12, fig.width=13, results="asis"}
comparison_vars = c(paste0('RNA_snn_res.', sel_res), 'project_id')
comparison_titles = c(paste('Clusters (resolution', paste0(sel_res, ')')), 'Projects')
for (jj in seq_along(comparison_vars)) {
  cat('####', comparison_titles[[jj]], '{.tabset}\n\n')
  for (ii in seq_along(label_f_ls)) {
    cat('#####', labeller_ls[[ii]], ',', model_ls[[ii]], '{.tabset}\n\n')
    confuse_dt = prepare_join_label_comparison(guesses_ls[[ii]], int_dt,
      comparison_vars[[jj]], min_cl2_p = min_cl2_p)
    for (normalization in c('column', 'row')) {
      view_title = if (normalization == 'row') 'Within cell types (rows sum to 1)'
        else if (comparison_vars[[jj]] == 'project_id') 'Within projects (columns sum to 1)'
        else 'Within clusters (columns sum to 1)'
      cat('######', view_title, '\n\n')
      draw(plot_join_label_comparison(confuse_dt, model_ls[[ii]],
        comparison_titles[[jj]], normalization, lbl_threshold), merge_legend = TRUE)
      cat('\n\n')
    }
  }
}
```

