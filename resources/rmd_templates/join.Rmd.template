${xgboost_title}

```{r xgb_load_data, eval = do_xgboost, include = FALSE}
xgb_preds_dt = fread(xgb_predictions_f)
xgb_gain_dt  = fread(xgb_importance_f)
xgb_feature_selection = read_xgboost_feature_selection("${xgb_model_card_f}")
xgb_dt       = merge(xgb_preds_dt, int_dt[, .(cell_id, UMAP1, UMAP2)],
  by = "cell_id", all.x = TRUE) %>% .[ !is.na(UMAP1) ]
xgb_style = read_xgboost_style(xgb_predictions_f, sort(unique(xgb_dt$label)))
xgb_dt = apply_xgboost_style(xgb_dt, xgb_style)
xgb_has_coarse = length(xgb_style$mapping) > 0
xgb_val_dt = xgb_dt[split == "validation"]

# Use full-data calls for the four evaluated cell groups when they are available.
xgb_full_f = sub('_predictions.csv.gz$', '_fulldata_predictions.csv.gz', xgb_predictions_f)
xgb_full_dt = if (file.exists(xgb_full_f)) fread(xgb_full_f) else copy(xgb_dt)
xgb_full_dt[!selected & split %in% c('train', 'validation'), split := 'development_holdout']
xgb_full_dt = apply_xgboost_style(xgb_full_dt, xgb_style)
```

```{r xgb_load_cpms, eval = do_xgboost, include = FALSE}
xgb_pb      = read_h5ad(xgb_pseudobulk_f, as = 'SingleCellExperiment')
if ('X' %in% assayNames(xgb_pb)) {
  assays(xgb_pb)[['X']] = NULL
}
xgb_cpms_dt = xgb_pb %>% make_logcpms_all_rmd("sample_id",
  lib_size_method = "edger", min_cells = xgb_min_cells, n_cores = 1L)
```

