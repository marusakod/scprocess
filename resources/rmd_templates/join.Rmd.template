```{r plot_labels_umap, eval=do_labels, include=do_labels, fig.height=5, fig.width=12, results="asis"}
for (ii in seq_along(label_f_ls)) {
  this_labeller  = labeller_ls[[ii]]
  this_model     = model_ls[[ii]]
  this_hi_res_cl = hi_res_cl_ls[[ii]]

  guesses_sel = guesses_ls[[ii]] %>%
    .[, .(cell_id, prediction = predicted_label_agg %>% factor)]
  int_tmp     = int_dt[, .(cell_id, UMAP1, UMAP2,
    hi_res_cl = get(this_hi_res_cl) %>% fct_infreq)]

  g_cl   = plot_umap_labels(int_dt,
    int_tmp[, .(cell_id, cluster = hi_res_cl)], "high resolution\ncluster")
  g_pred = plot_umap_labels(int_dt,
    guesses_sel[, .(cell_id, cluster = prediction)], "prediction\n(aggregated)")

  cat('####', this_labeller, ',', this_model, '\n')
  print(g_cl + g_pred)
  cat('\n\n')
}
