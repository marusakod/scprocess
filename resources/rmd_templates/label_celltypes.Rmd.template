```{r setup_input, include = FALSE}
# input_files
int_f           = "${int_f}"
guess_f_ls      = str_split("${guess_f_ls}", " ")[[ 1 ]]
labeller_ls     = str_split("${labeller_ls}", " ")[[ 1 ]]
model_ls        = str_split("${model_ls}", " ")[[ 1 ]]

# params
hi_res_cl_ls    = str_split("${hi_res_cl_ls}", " ")[[ 1 ]]
min_cl_prop_ls  = str_split("${min_cl_prop_ls}", " ")[[ 1 ]] %>% as.numeric
min_cl2_p       = 0.2
```

```{r load_umap, include = FALSE}
int_dt        = fread(int_f) %>% .[ (is_dbl == FALSE) & (in_dbl_cl == FALSE) ]
```

```{r load_guesses, include = FALSE}
# get predictions
assert_that( all(sapply(guess_f_ls, file.exists)) )
guesses_ls    = lapply(guess_f_ls, fread) %>% setNames(model_ls)
styles_ls = lapply(seq_along(model_ls), function(i) installed_label_style(model_ls[[i]]))
for (i in seq_along(guesses_ls)) {
  mapping = styles_ls[[i]]$mapping
  if (!length(mapping)) next
  for (suffix in c("naive","agg")) {
    original = guesses_ls[[i]][[paste0("predicted_label_",suffix)]]
    value = unname(mapping[original])
    value[is.na(value)] = original[is.na(value)]
    set(guesses_ls[[i]], j=paste0("coarse_predicted_label_",suffix), value=value)
  }
}

```

## Integration clusters vs predicted cell types{.tabset}

Prediction of cell type labels is a two-step process: The labeller first assigns a predicted cell type to each individual cell.
These cell-level predictions are then aggregated at the level of high-resolution clusters (a majority-voting approach is used, where the final, assigned label for a cluster is the most common predicted label among all the cells within it).

The heatmap helps to assess whether this aggregation step seems sensible. Each cell on the heatmap shows the proportion of cells within a cluster (on the x-axis) that are assigned a specific predicted cell type in the first step (on the y-axis). A cluster split across several predicted types may be mixed or transitional, and its voted label should be checked.

When the model groups its labels into broader classes, the **Grouped labels** tabs in each section show the same views for those groups.

```{r plot_cls_vs_pred, fig.height = 12, fig.width = 13, results = 'asis'}
for (ii in seq_along(guess_f_ls)) {
  # one tab per labeller and model, with Labels / Grouped labels tabs inside
  views    = get_label_views(guesses_ls[[ ii ]], styles_ls[[ ii ]])
  int_tmp  = int_dt[, .(cell_id, hi_res_cl = get(hi_res_cl_ls[[ ii ]]) %>% fct_infreq)]
  cat_label_views_heading(paste0(labeller_ls[[ ii ]], ', ', model_ls[[ ii ]]), views, level = 3)

  for (view_name in names(views)) {
    cat_label_view_tab(view_name, views, level = 3)
    guesses_sel = views[[ view_name ]]$labels_dt[, .(cell_id, prediction = predicted_label_naive %>% factor)]
    confuse_dt  = calc_confuse_dt(guesses_sel, int_tmp, "prediction", "hi_res_cl", min_cl2_p = min_cl2_p)
    draw(plot_cluster_comparison_heatmap(confuse_dt, "prediction", hi_res_cl_ls[[ ii ]],
      plot_var = 'log_p_cl2', do_sort = "hclust"), merge_legend = TRUE)
    cat('\n\n')
  }
}
```

## Predicted cell types over UMAP{.tabset}

The left UMAP shows the high-resolution clusters, numbered at their centres; the right shows the labels assigned to them by cluster voting. Each tab shows one labeller and model.

```{r plot_preds_over_umap, fig.height = 5, fig.width = 12, results = 'asis'}
for (ii in seq_along(guess_f_ls)) {
  # high-resolution clusters on the left; their numbers are printed because
  # cluster colours repeat once the palette runs out
  views    = get_label_views(guesses_ls[[ ii ]], styles_ls[[ ii ]])
  int_tmp  = int_dt[, .(cell_id, cluster = get(hi_res_cl_ls[[ ii ]]) %>% fct_infreq)]
  g_cl     = plot_umap_labels(int_dt, int_tmp, "high resolution\nharmony\ncluster", label_clusters = TRUE)
  cat_label_views_heading(paste0(labeller_ls[[ ii ]], ', ', model_ls[[ ii ]]), views, level = 3)

  for (view_name in names(views)) {
    cat_label_view_tab(view_name, views, level = 3)
    view    = views[[ view_name ]]
    g_pred  = plot_umap_labels(int_dt, view$labels_dt[, .(cell_id, cluster = predicted_label_agg)],
      "prediction\n(aggregated)", label_order = view$order, label_colours = view$colours)
    print(g_cl + g_pred)
    cat('\n\n')
  }
}
```


## Totals for each predicted cell type{.tabset}

Cell counts for each predicted label, before and after cluster voting, shown separately for each labeller and model.

```{r tbl_of_celltypes, results = "asis"}
for (ii in seq_along(guess_f_ls)) {
  views = get_label_views(guesses_ls[[ ii ]], styles_ls[[ ii ]])
  cat_label_views_heading(paste0(labeller_ls[[ ii ]], ', ', model_ls[[ ii ]]), views, level = 3)

  for (view_name in names(views)) {
    cat_label_view_tab(view_name, views, level = 3)
    view = views[[ view_name ]]
    view$labels_dt %>% calc_labels_table(label_order = view$order) %>% kbl("html") %>% row_spec(row = 0, bold = TRUE) %>%
      kable_styling(bootstrap_options = "striped", full_width = FALSE, font_size = 12, position = "center") %>%
      scroll_box(width = "60%", height = "500px") %>% print
    cat('\n\n')
  }
}
```

