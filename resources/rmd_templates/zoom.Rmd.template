```{r setup_zoom_qc, include = FALSE}
# parse zoom QC thresholds (empty string means not set)
.parse_zoom_thr = function(x) { x = trimws(x); if (x == "" || x == "None") NA_real_ else as.numeric(x) }
zoom_qc = list(
  qc_min_counts = .parse_zoom_thr(zoom_qc_min_counts),
  qc_max_counts = .parse_zoom_thr(zoom_qc_max_counts),
  qc_min_feats  = .parse_zoom_thr(zoom_qc_min_feats),
  qc_max_feats  = .parse_zoom_thr(zoom_qc_max_feats),
  qc_min_mito   = .parse_zoom_thr(zoom_qc_min_mito),
  qc_max_mito   = .parse_zoom_thr(zoom_qc_max_mito),
  qc_min_splice = .parse_zoom_thr(zoom_qc_min_splice),
  qc_max_splice = .parse_zoom_thr(zoom_qc_max_splice)
)
has_zoom_qc = any(!is.na(unlist(zoom_qc)))

# load pre-filter labels to identify cells before zoom QC
sel_labels_vec  = str_split(zoom_sel_labels, ",")[[1]]
pre_lbls_df     = fread(zoom_original_lbls_f)
pre_cell_ids    = pre_lbls_df[ get(zoom_lbls_col) %chin% sel_labels_vec ]$cell_id

# load post-filter labels
post_lbls_df    = fread(zoom_lbls_f)
post_cell_ids   = post_lbls_df[ get(zoom_lbls_col) %chin% sel_labels_vec ]$cell_id
report_lbls_df  = fread(zoom_report_lbls_f)
do_label_celltypes = nzchar(zoom_label_hi_res_cl) &&
  all(c('predicted_label_naive', 'predicted_label_agg') %in% names(report_lbls_df))

# load qc_all and subset to the zoom cells
qc_all_dt       = fread(qc_f) %>% .[ keep == TRUE ]
pre_qc_dt       = qc_all_dt[ cell_id %chin% pre_cell_ids ] %>% setnames(batch_var, "batch_var")
post_qc_dt      = qc_all_dt[ cell_id %chin% post_cell_ids ] %>% setnames(batch_var, "batch_var")

# build batch levels from metadata
zoom_b_lvls     = meta_dt[[batch_var]] %>% intersect(unique(pre_qc_dt$batch_var))
zoom_n_batches  = length(zoom_b_lvls)

# build cuts_dt from zoom QC thresholds (same thresholds for all batches)
zoom_cuts_rows = list()
if (!is.na(zoom_qc$qc_min_counts) || !is.na(zoom_qc$qc_max_counts)) {
  counts_min = if (!is.na(zoom_qc$qc_min_counts)) log10(zoom_qc$qc_min_counts) else -Inf
  counts_max = if (!is.na(zoom_qc$qc_max_counts)) log10(zoom_qc$qc_max_counts) else Inf
  zoom_cuts_rows = c(zoom_cuts_rows, lapply(zoom_b_lvls, function(b)
    data.table(batch_var = b, qc_var = "log_counts", min = counts_min, max = counts_max)))
}
if (!is.na(zoom_qc$qc_min_feats) || !is.na(zoom_qc$qc_max_feats)) {
  feats_min = if (!is.na(zoom_qc$qc_min_feats)) log10(zoom_qc$qc_min_feats) else -Inf
  feats_max = if (!is.na(zoom_qc$qc_max_feats)) log10(zoom_qc$qc_max_feats) else Inf
  zoom_cuts_rows = c(zoom_cuts_rows, lapply(zoom_b_lvls, function(b)
    data.table(batch_var = b, qc_var = "log_feats", min = feats_min, max = feats_max)))
}
if (!is.na(zoom_qc$qc_min_mito) || !is.na(zoom_qc$qc_max_mito)) {
  mito_min = if (!is.na(zoom_qc$qc_min_mito)) qlogis(zoom_qc$qc_min_mito) else -Inf
  mito_max = if (!is.na(zoom_qc$qc_max_mito)) qlogis(zoom_qc$qc_max_mito) else Inf
  zoom_cuts_rows = c(zoom_cuts_rows, lapply(zoom_b_lvls, function(b)
    data.table(batch_var = b, qc_var = "logit_mito", min = mito_min, max = mito_max)))
}
if (!is.na(zoom_qc$qc_min_splice) || !is.na(zoom_qc$qc_max_splice)) {
  splice_min = if (!is.na(zoom_qc$qc_min_splice)) qlogis(zoom_qc$qc_min_splice) else -Inf
  splice_max = if (!is.na(zoom_qc$qc_max_splice)) qlogis(zoom_qc$qc_max_splice) else Inf
  zoom_cuts_rows = c(zoom_cuts_rows, lapply(zoom_b_lvls, function(b)
    data.table(batch_var = b, qc_var = "logit_spliced", min = splice_min, max = splice_max)))
}
zoom_cuts_dt = if (length(zoom_cuts_rows) > 0) rbindlist(zoom_cuts_rows) else
  data.table(batch_var = character(), qc_var = character(), min = numeric(), max = numeric())

zoom_violin_h = 0.4
zoom_marg_h   = min((zoom_n_batches + 1) * zoom_violin_h, 12)
```

