```{r setup_input, include = FALSE}
# input files (substituted by glue from snakemake params)
predictions_f   = "${predictions_f}"
importance_f    = "${importance_f}"
integration_f   = "${integration_f}"
has_coarse      = as.logical("${has_coarse}")

# load data
preds_dt    = fread(predictions_f)
imp_dt      = fread(importance_f)
int_dt      = fread(integration_f)[, .(cell_id, UMAP1, UMAP2)]
```


```{r merge_umap, include = FALSE}
plot_dt = merge(preds_dt, int_dt, by = "cell_id", all.x = TRUE) %>%
  .[ !is.na(UMAP1) ]
```


## Train / Validation Split

The dataset was split into training and validation sets. When more than 4 samples are available, entire samples are held out for validation (strongest generalization test). Otherwise a stratified random cell-level split is used.

```{r plot_split, fig.height = 6, fig.width = 8}
ggplot(plot_dt) +
  aes(x = UMAP1, y = UMAP2, colour = split) +
  geom_point(size = 0.3, alpha = 0.5) +
  scale_colour_manual(values = c("train" = "#1f77b4", "validation" = "#ff7f0e")) +
  theme_bw() +
  theme(aspect.ratio = 1, axis.text = element_blank(), axis.ticks = element_blank(),
        panel.grid = element_blank()) +
  labs(colour = "Split")
```


## Predicted vs True Labels {.tabset}

UMAPs showing the true (training) labels alongside model predictions on the **validation** set. Good agreement indicates the model has learned to generalize across samples.

### Fine labels

```{r plot_fine_labels, fig.height = 7, fig.width = 14}
val_dt = plot_dt[ split == "validation" ]
p1 = ggplot(val_dt) +
  aes(x = UMAP1, y = UMAP2, colour = label) +
  geom_point(size = 0.3, alpha = 0.5) +
  theme_bw() +
  theme(aspect.ratio = 1, axis.text = element_blank(), axis.ticks = element_blank(),
        panel.grid = element_blank(), legend.text = element_text(size = 6)) +
  labs(colour = "True label", title = "True labels (validation)")

p2 = ggplot(val_dt) +
  aes(x = UMAP1, y = UMAP2, colour = predicted_label) +
  geom_point(size = 0.3, alpha = 0.5) +
  theme_bw() +
  theme(aspect.ratio = 1, axis.text = element_blank(), axis.ticks = element_blank(),
        panel.grid = element_blank(), legend.text = element_text(size = 6)) +
  labs(colour = "Predicted label", title = "Predicted labels (validation)")

p1 + p2
```


