```{r load_inputs, include=FALSE}
report_data = load_cell_cycle_report_data(
  scores_f = "${scores_f}", origin_f = "${origin_f}",
  sensitivity_f = "${sensitivity_f}", diagnostics_f = "${diagnostics_f}",
