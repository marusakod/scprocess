{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["zoom"],
  "properties": {
    "zoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "labels_source", "sel_labels", "labels_col"],
      "properties": {
        "name":             { "type": "string" },
        "labels_source":    { "type": "string", "enum": ["clusters", "celltypist", "scprocess", "custom"] },
        "model":            { "type": "string" },
        "sel_labels":       { "type": "array", "items": { "type": "string" } },
        "labels_col":       { "type": "string" },
        "custom_labels_f":  { "type": "string" },
        "exclude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sample_id": { "type": "array", "items": { "type": "string" } },
            "pool_id":   { "type": "array", "items": { "type": "string" } }
          }
        },
        "save_subset_sces":        { "type": "boolean", "default": false },
        "save_subset_anndata":     { "type": "boolean", "default": true },
        "save_cluster_names_file": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": {"properties": {"labels_source": { "const": "clusters" } } },
          "then": {
            "allOf": [
              {"not": { "required": ["model"] }},
              {"not": { "required": ["custom_labels_f"] }}
            ]
          }
        },
        {
          "if": {"properties": {"labels_source": { "enum": ["celltypist", "scprocess"] } } },
          "then": {
            "allOf": [
              { "required": ["model"] }, 
              {"not": { "required": ["custom_labels_f"] }}
            ]
          }
        },
        {
          "if": {"properties": {"labels_source": { "const": "custom" } } },
          "then": {
            "allOf": [
              { "required": ["custom_labels_f"] }, 
              {"not": { "required": ["model"] }}
            ]
          }
        },
        {
          "if": {
            "required": ["save_cluster_names_file"],
            "properties": {"save_cluster_names_file": { "const": true } }
          },
          "then": {
            "properties": {"labels_source": { "enum": ["celltypist", "scprocess"] } }
          }
        }
      ]
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qc_min_cells":  { "type": "integer", "exclusiveMinimum": 0, "default": 10 },
        "qc_min_counts": { "type": ["integer", "null"], "exclusiveMinimum": 0, "default": null },
        "qc_max_counts": { "type": ["integer", "null"], "exclusiveMinimum": 0, "default": null },
        "qc_min_feats":  { "type": ["integer", "null"], "exclusiveMinimum": 0, "default": null },
        "qc_max_feats":  { "type": ["integer", "null"], "exclusiveMinimum": 0, "default": null },
        "qc_min_mito":   { "type": ["number", "null"],  "minimum": 0, "maximum": 1, "default": null },
        "qc_max_mito":   { "type": ["number", "null"],  "minimum": 0, "maximum": 1, "default": null },
        "qc_min_splice": { "type": ["number", "null"],  "minimum": 0, "maximum": 1, "default": null },
        "qc_max_splice": { "type": ["number", "null"],  "minimum": 0, "maximum": 1, "default": null }
      }
    },
    "pb_empties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambient_genes_logfc_thr":  { "type": "number", "default": 0 },
        "ambient_genes_fdr_thr":    { "type": "number", "default": 0.01 }
      }
    },
    "hvg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hvg_method":                 { "type": "string", "enum": ["sample", "all", "groups"], "default": "sample" },
        "hvg_n_hvgs":                 { "type": "integer", "default": 2000 },
        "hvg_chunk_size":             { "type": "integer", "default": 2000 },
        "hvg_exclude_ambient_genes":  { "type": "boolean", "default": true },
        "hvg_exclude_from_file":      { "type": "string", "items": {"type": "string", "pattern": "^.+\\.csv$"} },
        "hvg_metadata_split_var":     { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {"properties": {"hvg_method": {"const": "groups" } } },
          "then": { "required": ["hvg_metadata_split_var" ] },
          "else": {
            "not": { "required": ["hvg_metadata_split_var"] }
          }
        }
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "int_use_gpu":      { "type": "boolean",  "default": true},
        "int_embedding":    { "type": "string", "enum": ["harmony", "pca"], "default": "harmony" },
        "int_theta":        { "type": "number", "default": 0.1 },
        "int_n_dims":       { "type": "integer", "default": 50 },
        "int_cl_method":    { "type": "string", "enum": ["leiden"], "default": "leiden"},
        "int_use_paga":     { "type": "boolean",  "default": true},
        "int_paga_cl_res":  { "type": "number",   "default": 2},
        "int_res_ls": {
          "type":     "array",
          "items":    { "type": "number" },
          "default":  [0.1, 0.2, 0.5, 1, 2]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"int_use_paga": {"const": true}}},
          "then": {
            "required": ["int_paga_cl_res"]
          },
          "else": {
            "not": {"required": ["int_paga_cl_res"]}
          }
        }
      ]
    },
    "marker_genes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mkr_sel_res":      { "type": "number",   "default": 0.2 },
        "mkr_min_cl_size":  { "type": "integer",  "default": 100 },
        "mkr_min_cells":    { "type": "integer",  "default": 10 },
        "mkr_not_ok_re":    { "type": "string",   "default": "(lincRNA|lncRNA|pseudogene|antisense)" },
        "mkr_min_cpm_mkr":  { "type": "integer",  "default": 50 },
        "mkr_min_cpm_go":   { "type": "integer",  "default": 1 },
        "mkr_max_zero_p":   { "type": "number",   "default": 0.5 },
        "mkr_do_gsea":      { "type": "boolean",  "default": true },
        "mkr_gsea_cut":     { "type": "number",   "default": 0.1 },
        "mkr_gsea_var":     { "type": "string",   "default": "z_score", "enum": ["logFC", "z_score"] },
        "mkr_custom_genesets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^,]*$" },
              "file": { "type": "string" }
            }
          }
        }
      }
    },
    "train_xgboost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annots_f"],
      "properties": {
        "annots_f":              { "type": "string" },
        "ref_tag":               { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "label_map_f":           { "type": ["string", "null"], "default": null },
        "refine_labels":         { "type": "boolean", "default": true },
        "purity_threshold":      { "type": "number", "minimum": 0, "maximum": 1, "default": 0.65 },
        "n_cells_per_type":      { "type": "integer", "minimum": 1, "default": 1000 },
        "min_cells_per_type":    { "type": "integer", "minimum": 1, "default": 20 },
        "min_cells_expressed":   { "type": "integer", "minimum": 1, "default": 10 },
        "gene_exclude_re":       { "type": ["string", "null"], "default": "(lincRNA|lncRNA|pseudogene|antisense)" },
        "seed":                  { "type": "integer", "default": 42 },
        "use_gpu":               { "type": "boolean", "default": false },
        "pass1_subsample":       { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.632 },
        "pass1_colsample_bytree":{ "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.1 },
        "pass1_learning_rate":   { "type": "number", "exclusiveMinimum": 0, "default": 0.1 },
        "pass1_nrounds":         { "type": "integer", "minimum": 1, "default": 300 },
        "pass1_early_stopping":  { "type": "integer", "minimum": 1, "default": 10 },
        "pass2_colsample_bytree":{ "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.5 },
        "pass2_learning_rate":   { "type": "number", "exclusiveMinimum": 0, "default": 0.05 },
        "pass2_nrounds":         { "type": "integer", "minimum": 1, "default": 500 },
        "pass2_early_stopping":  { "type": "integer", "minimum": 1, "default": 10 },
        "gain_threshold":        { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.9 },
        "min_genes":             { "type": "integer", "minimum": 1, "default": 100 },
        "max_genes":             { "type": "integer", "minimum": 1, "default": 3000 }
      }
    },
    "shiny": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app_title":      { "type": "string" },
        "email":          { "type": "string" },
        "keyword":        { "type": "string",  "default": "cells" },
        "default_gene":   { "type": "string",  "default": "" },
        "n_keep":         { "type": "integer", "exclusiveMinimum": 0, "default": 30000 },
        "metadata_vars":  { "type": "array",  "items": { "type": "string" } },
        "metadata_labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "var_names":      { "type": "array",   "items": { "type": "string" } },
        "metadata_combns": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        },
        "home_md":          { "type": "string" },
        "annotation_csv":   { "type": "string" },
        "cluster_palette":  { "type": "string" },
        "metadata_palettes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } },
              { "type": "object",
                "additionalProperties": false,
                "properties": {
                  "palette":  { "type": "string" },
                  "colours":  { "type": "array", "items": { "type": "string" } },
                  "values":   { "type": "array", "items": { "type": "string" } }
                }
              }
            ]
          }
        }
      }
    }
  }
}
