{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scprocess_config_f", "annots_f", "ref_tag"],
  "properties": {
    "scprocess_config_f":    { "type": "string" },
    "annots_f":              { "type": "string" },
    "ref_tag":               { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "label_map_f":           { "type": ["string", "null"], "default": null },
    "refine_labels":         { "type": "boolean", "default": true },
    "purity_threshold":      { "type": "number", "minimum": 0, "maximum": 1, "default": 0.65 },
    "n_cells_per_type":      { "type": "integer", "minimum": 1, "default": 1000 },
    "min_cells_per_type":    { "type": "integer", "minimum": 1, "default": 20 },
    "min_cells_expressed":   { "type": "integer", "minimum": 1, "default": 10 },
    "gene_exclude_re":       { "type": ["string", "null"], "default": "(lincRNA|lncRNA|pseudogene|antisense)" },
    "seed":                  { "type": "integer", "default": 42 },
    "n_cores":               { "type": "integer", "minimum": 1, "default": 4 },
    "use_gpu":               { "type": "boolean", "default": false },
    "pass1_subsample":       { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.632 },
    "pass1_colsample_bytree":{ "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.1 },
    "pass1_learning_rate":   { "type": "number", "exclusiveMinimum": 0, "default": 0.1 },
    "pass1_nrounds":         { "type": "integer", "minimum": 1, "default": 300 },
    "pass1_early_stopping":  { "type": "integer", "minimum": 1, "default": 10 },
    "pass2_colsample_bytree":{ "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.5 },
    "pass2_learning_rate":   { "type": "number", "exclusiveMinimum": 0, "default": 0.05 },
    "pass2_nrounds":         { "type": "integer", "minimum": 1, "default": 500 },
    "pass2_early_stopping":  { "type": "integer", "minimum": 1, "default": 10 },
    "gain_threshold":        { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.9 },
    "min_genes":             { "type": "integer", "minimum": 1, "default": 100 },
    "max_genes":             { "type": "integer", "minimum": 1, "default": 3000 },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gb_train_xgboost":    { "type": "integer", "default": 32 },
        "mins_train_xgboost":  { "type": "integer", "default": 180 }
      }
    }
  }
}
