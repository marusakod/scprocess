{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["join", "projects"],
  "properties": {
    "zoom": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string" }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "proj_dir", "date_stamp", "your_name", "affiliation"],
      "properties": {
        "name":             { "type": "string" },
        "proj_dir":         { "type": "string" },
        "date_stamp":       { "type": "string", "format": "date" },
        "ref_txome":        { "type": "string" },
        "probe_set":        { "type": "string" },
        "tenx_assay_type":  { "type": "string", "enum": ["flex", "poly_a"], "default": "poly_a" },
        "your_name":        { "type": "string" },
        "affiliation":      { "type": "string" },
        "metadata_vars":    { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if":   { "properties": { "tenx_assay_type": { "const": "flex" } }, "required": ["tenx_assay_type"] },
          "then": { "required": ["probe_set"],  "not": { "required": ["ref_txome"] } },
          "else": { "required": ["ref_txome"],  "not": { "required": ["probe_set"] } }
        }
      ]
    },
    "projects": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["config"],
        "properties": {
          "config":    { "type": "string" },
          "zoom_name": { "type": "string" }
        }
      }
    },
    "hvg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hvg_n_hvgs": { "type": "integer", "default": 2000 }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "int_pca_method":   { "type": "string",   "enum": ["bpcells", "scanpy"], "default": "bpcells" },
        "int_cell_cycle_correction": { "type": "string", "enum": ["within_sample", "global"] },
        "int_cell_cycle_harmonics": { "type": "integer", "enum": [1, 2], "default": 2, "x-default-requires": "int_cell_cycle_correction" },
        "int_cell_cycle_ridge_lambda": { "type": "number", "minimum": 0, "default": 0.1, "x-default-requires": "int_cell_cycle_correction" },
        "int_use_gpu":      { "type": "boolean",  "default": true },
        "int_embedding":    { "type": "string",   "enum": ["harmony", "pca"], "default": "harmony" },
        "int_theta": {
          "oneOf": [
            { "type": "number" },
            { "type": "array", "items": { "type": "number" } }
          ],
          "default": 0.1
        },
        "int_batch_var": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ],
          "default": "sample_id"
        },
        "int_n_dims":       { "type": "integer", "default": 50 },
        "int_umap_n_iter": { "type": "integer", "minimum": 1, "default": 2000 },
        "int_cl_method":    { "type": "string",  "enum": ["leiden"], "default": "leiden" },
        "int_use_paga":     { "type": "boolean", "default": true },
        "int_paga_cl_res":  { "type": "number",  "default": 2 },
        "int_res_ls": {
          "type":     "array",
          "items":    { "type": "number" },
          "default":  [0.1, 0.2, 0.5, 1, 2]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"int_use_paga": {"const": true}}},
          "then": { "required": ["int_paga_cl_res"] },
          "else": { "not": {"required": ["int_paga_cl_res"]} }
        }
      ]
    },
    "marker_genes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mkr_sel_res":      { "type": "number",   "default": 0.2 },
        "mkr_min_cl_size":  { "type": "integer",  "default": 100 },
        "mkr_min_cells":    { "type": "integer",  "default": 1 },
        "mkr_adjust_project_id": { "type": "boolean", "default": false },
        "mkr_not_ok_re":    { "type": "string",   "default": "(lincRNA|lncRNA|pseudogene|antisense)" },
        "mkr_min_cpm_mkr":  { "type": "integer",  "default": 50 },
        "mkr_min_cpm_go":   { "type": "integer",  "default": 1 },
        "mkr_max_zero_p":   { "type": "number",   "default": 0.5 },
        "mkr_do_gsea":      { "type": "boolean",  "default": true },
        "mkr_gsea_cut":     { "type": "number",   "default": 0.1 },
        "mkr_gsea_var":     { "type": "string",   "default": "z_score", "enum": ["logFC", "z_score"] },
        "mkr_custom_genesets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^,]*$" },
              "file": { "type": "string" }
            }
          }
        }
      }
    },
    "shiny": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app_tag":        { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "description": "Machine-safe app identifier used in the deployment directory and generated filenames; defaults to join.name" },
        "app_title":      { "type": "string" },
        "email":          { "type": "string" },
        "keyword":        { "type": "string",  "default": "cells" },
        "default_gene":   { "type": "string",  "default": "" },
        "n_keep":         { "type": "integer", "exclusiveMinimum": 0, "default": 30000 },
        "metadata_vars":  { "type": "array",  "items": { "type": "string" } },
        "metadata_labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "var_names":      { "type": "array",   "items": { "type": "string" } },
        "metadata_combns": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        },
        "home_md":          { "type": "string" },
        "annotation_csv":   { "type": "string" },
        "cluster_palette":  { "type": "string" },
        "metadata_palettes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } },
              { "type": "object",
                "additionalProperties": false,
                "properties": {
                  "palette":  { "type": "string" },
                  "colours":  { "type": "array", "items": { "type": "string" } },
                  "values":   { "type": "array", "items": { "type": "string" } }
                }
              }
            ]
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n_join_marker_genes_calc":          { "type": "integer", "minimum": 1, "default": 8 },
        "gb_join_zoom_prepare":        { "type": "integer", "minimum": 1, "default": 16 },
        "mins_join_zoom_prepare":      { "type": "integer", "minimum": 1, "default": 30 },
        "gb_join_zoom_calculate_raw_gene_count_statistics": {"type": "integer", "minimum": 1, "default": 8},
        "gb_join_zoom_hvg_stats": {"type": "integer", "minimum": 1, "description": "Legacy alias for gb_join_zoom_calculate_raw_gene_count_statistics"},
        "mins_join_zoom_calculate_raw_gene_count_statistics": {"type": "integer", "minimum": 1, "default": 60},
        "mins_join_zoom_hvg_stats": {"type": "integer", "minimum": 1, "description": "Legacy alias for mins_join_zoom_calculate_raw_gene_count_statistics"},
        "gb_join_zoom_fit_expected_gene_variances": {"type": "integer", "minimum": 1, "default": 32},
        "gb_join_zoom_hvg_trend": {"type": "integer", "minimum": 1, "description": "Legacy alias for gb_join_zoom_fit_expected_gene_variances"},
        "mins_join_zoom_fit_expected_gene_variances": {"type": "integer", "minimum": 1, "default": 60},
        "mins_join_zoom_hvg_trend": {"type": "integer", "minimum": 1, "description": "Legacy alias for mins_join_zoom_fit_expected_gene_variances"},
        "gb_join_zoom_calculate_clipped_gene_count_statistics": {"type": "integer", "minimum": 1, "default": 8},
        "gb_join_zoom_hvg_clip": {"type": "integer", "minimum": 1, "description": "Legacy alias for gb_join_zoom_calculate_clipped_gene_count_statistics"},
        "mins_join_zoom_calculate_clipped_gene_count_statistics": {"type": "integer", "minimum": 1, "default": 60},
        "mins_join_zoom_hvg_clip": {"type": "integer", "minimum": 1, "description": "Legacy alias for mins_join_zoom_calculate_clipped_gene_count_statistics"},
        "gb_join_zoom_rank_and_select_highly_variable_genes": {"type": "integer", "minimum": 1, "default": 32},
        "gb_join_zoom_hvgs": {"type": "integer", "minimum": 1, "description": "Legacy alias for gb_join_zoom_rank_and_select_highly_variable_genes"},
        "mins_join_zoom_rank_and_select_highly_variable_genes": {"type": "integer", "minimum": 1, "default": 30},
        "mins_join_zoom_hvgs": {"type": "integer", "minimum": 1, "description": "Legacy alias for mins_join_zoom_rank_and_select_highly_variable_genes"},
        "gb_join_select_hvgs":        { "type": "integer", "default": 4 },
        "gb_join_build_matrix":       { "type": "integer", "default": 16 },
        "gb_join_build_coldata":      { "type": "integer", "default": 4 },
        "gb_join_build_sample_metadata": { "type": "integer", "default": 2 },
        "gb_join_build_qc":           { "type": "integer", "default": 4 },
        "gb_join_build_bpcells_matrix": { "type": "integer", "default": 16 },
        "gb_join_pca":                { "type": "integer", "default": 16 },
        "gb_join_integration":        { "type": "integer", "default": 16 },
        "gb_join_build_h5ads_yaml":   { "type": "integer", "default": 4 },
        "gb_join_make_pseudobulks":   { "type": "integer", "default": 16 },
        "gb_join_marker_genes_prep":{ "type": "integer", "default": 16 },
        "gb_join_calc_hvgs":          { "type": "integer", "default": 8 },
        "gb_join_marker_genes_calc":       { "type": "integer", "default": 16 },
        "gb_join_marker_plot_data":   { "type": "integer", "default": 8 },
        "gb_join_fgsea":              { "type": "integer", "default": 16 },
        "gb_join_celltypist":         { "type": "integer", "default": 16 },
        "gb_join_scprocess_labeller": { "type": "integer", "default": 16 },
        "gb_join_merge_labels":       { "type": "integer", "default": 16 },
        "gb_join_render_html":        { "type": "integer", "default": 16 },
        "mins_join_select_hvgs":        { "type": "integer", "default": 10 },
        "mins_join_build_matrix":       { "type": "integer", "default": 30 },
        "mins_join_build_coldata":      { "type": "integer", "default": 5 },
        "mins_join_build_sample_metadata": { "type": "integer", "default": 5 },
        "mins_join_build_qc":           { "type": "integer", "default": 5 },
        "mins_join_build_bpcells_matrix": { "type": "integer", "default": 60 },
        "mins_join_pca":                { "type": "integer", "default": 180 },
        "mins_join_integration":        { "type": "integer", "default": 60 },
        "mins_join_build_h5ads_yaml":   { "type": "integer", "default": 5 },
        "mins_join_make_pseudobulks":   { "type": "integer", "default": 60 },
        "mins_join_marker_genes_prep":{ "type": "integer", "default": 60 },
        "mins_join_calc_hvgs":          { "type": "integer", "default": 30 },
        "mins_join_marker_genes_calc":       { "type": "integer", "default": 90 },
        "mins_join_marker_plot_data":   { "type": "integer", "default": 30 },
        "mins_join_fgsea":              { "type": "integer", "default": 30 },
        "mins_join_celltypist":         { "type": "integer", "default": 30 },
        "mins_join_scprocess_labeller": { "type": "integer", "default": 30 },
        "mins_join_merge_labels":       { "type": "integer", "default": 10 },
        "mins_join_render_html":        { "type": "integer", "default": 30 },
        "gb_join_extract_labels":       { "type": "integer", "default": 4 },
        "mins_join_extract_labels":     { "type": "integer", "default": 10 },
        "gb_join_train_xgboost_prepare":     { "type": "integer", "minimum": 1, "default": 8 },
        "mins_join_train_xgboost_prepare":   { "type": "integer", "minimum": 1, "default": 10 },
        "gb_join_train_xgboost_train":       { "type": "integer", "default": 32 },
        "gb_join_train_xgboost_predict":     { "type": "integer", "default": 8 },
        "gb_join_train_xgboost_combine":   { "type": "integer", "default": 8 },
        "gb_join_render_html_train_xgboost": { "type": "integer", "default": 8 },
        "mins_join_train_xgboost_train":       { "type": "integer", "default": 180 },
        "mins_join_train_xgboost_predict":     { "type": "integer", "default": 30 },
        "mins_join_train_xgboost_combine":   { "type": "integer", "default": 30 },
        "mins_join_render_html_train_xgboost": { "type": "integer", "default": 15 },
        "gb_build_shiny_app":           { "type": "integer", "default": 16 },
        "mins_build_shiny_app":         { "type": "integer", "default": 30 },
        "retries":                      { "type": "integer", "default": 0 }
      }
    },
    "label_celltypes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["labeller", "model"],
        "properties": {
          "labeller":     { "type": "string", "enum": ["celltypist", "scprocess"] },
          "model":        { "type": "string" },
          "hi_res_cl":    { "type": "string", "default": "RNA_snn_res.2" },
          "min_cl_prop":  { "type": "number", "default": 0.5 },
          "save_cluster_names_file": { "type": "boolean", "default": false }
        }
      }
    },
    "train_xgboost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annots_f"],
      "properties": {
        "annots_f": {"type": "string"},
        "label_map_f": {"type": ["string", "null"], "default": null},
        "label_specs_f": {"type": ["string", "null"], "default": null},
        "coarse_label_specs_f": {"type": ["string", "null"], "default": null},
        "min_cells_per_label": {"type": "integer", "minimum": 1, "default": 20},
        "min_cells_expressed": {"type": "integer", "minimum": 1, "default": 10},
        "gene_exclude_re": {"type": ["string", "null"], "default": "(lincRNA|lncRNA|pseudogene|antisense)"},
        "seed": {"type": "integer", "default": 42},
        "use_gpu": {"type": "boolean", "default": false},
        "pass1_subsample": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.632},
        "pass1_colsample_bytree": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.1},
        "pass1_learning_rate": {"type": "number", "exclusiveMinimum": 0, "default": 0.1},
        "pass1_nrounds": {"type": "integer", "minimum": 1, "default": 300},
        "pass1_early_stopping": {"type": "integer", "minimum": 1, "default": 10},
        "pass2_colsample_bytree": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.5},
        "pass2_learning_rate": {"type": "number", "exclusiveMinimum": 0, "default": 0.05},
        "pass2_nrounds": {"type": "integer", "minimum": 1, "default": 500},
        "pass2_early_stopping": {"type": "integer", "minimum": 1, "default": 10},
        "gain_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.9},
        "min_genes": {"type": "integer", "minimum": 1, "default": 100},
        "max_genes": {"type": "integer", "minimum": 1, "default": 3000},
        "xgboost_tag": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "excluded_labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
        "cluster_majority_vote_resolution": {"type": "number", "exclusiveMinimum": 0},
        "cluster_majority_vote_min_purity": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.9},
        "test_group_var": {"type": "string", "minLength": 1},
        "test_groups": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "validation_group_var": {"type": "string", "minLength": 1, "default": "batch"},
        "validation_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.2},
        "validation_variable_combinations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
        "sampling_variable_combinations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
        "train_cells_per_label": {"type": "integer", "minimum": 1, "default": 2000},
        "validation_cells_per_label": {"type": "integer", "minimum": 1, "default": 500}
      },
      "allOf": [{"if": {"required": ["test_group_var"]}, "then": {"required": ["test_groups"]}}, {"if": {"required": ["test_groups"]}, "then": {"required": ["test_group_var"]}}]
    }
  }
}
