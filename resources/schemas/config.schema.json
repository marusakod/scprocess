{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proj_dir", "full_tag", "short_tag", "your_name", "affiliation",
        "date_stamp", "sample_metadata"],
      "properties": {
        "proj_dir":             { "type": "string" },
        "fastq_dir":            { "type": "string" },
        "arv_uuids":            { "type": "array", "items": {"type": "string", "pattern": "^.+-[0-9a-z]{5}-[0-9a-z]{15}$"} },
        "arv_instance":         { "type": "string" },
        "full_tag":             { "type": "string" },
        "short_tag":            { "type": "string" },
        "your_name":            { "type": "string" },
        "affiliation":          { "type": "string" },
        "date_stamp":           { "type": "string", "format": "date" },
        "sample_metadata":      { "type": "string", "items": {"type": "string", "pattern": "^.+\\.csv$"} },
        "ref_txome":            { "type": "string" },
        "probe_set":            { "type": "string" },
        "tenx_assay_type":      { "type": "string", "enum": ["flex", "poly_a"], "default": "poly_a" },
        "tenx_chemistry":       { "type": "string", "enum": ["none", "3v2", "3v3", "3v4", "5v1", "5v2", "5v3", "multiome", "flexv1", "flexv2"],  "default": "none"},
        "metadata_vars":        { "type": "array", "items": { "type": "string" } },
        "show_arv_uuids":       { "type": "boolean", "default": true },
        "custom_sample_params": { "type": "string" },
        "exclude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sample_id":  { "type": "array", "items": { "type": "string" } },
            "pool_id":    { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "dependentRequired": {
        "arv_uuids": ["arv_instance"]
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["fastq_dir"] },
            { "required": ["arv_uuids"] }
          ]
        },
        {
          "if":   { "properties": { "tenx_assay_type": { "const": "flex" } }, "required": ["tenx_assay_type"] },
          "then": { "required": ["probe_set"],  "not": { "required": ["ref_txome"] } },
          "else": { "required": ["ref_txome"],  "not": { "required": ["probe_set"] } }
        },
        {
          "if":   { "properties": { "tenx_assay_type": { "const": "flex" } }, "required": ["tenx_assay_type"] },
          "then": { "properties": { "tenx_chemistry": { "enum": ["none", "flexv1", "flexv2"] } } },
          "else": { "properties": { "tenx_chemistry": { "enum": ["none", "3v2", "3v3", "3v4", "5v1", "5v2", "5v3", "multiome"] } } }
        }
      ]
    },
    "multiplexing": {
      "title": "Multiplexing Configuration",
      "type": "object",
      "additionalProperties": false,
      "required": [ "demux_type" ],
      "properties": {
        "demux_type":       { "type": "string", "enum": ["none", "hto", "ocm", "flex", "custom"], "default": "none" },
        "fastq_dir":        { "type": "string" },
        "arv_uuids":        { "type": "array", "items": {"type": "string", "pattern": "^arkau-[0-9a-z]{5}-[0-9a-z]{15}$"} },
        "feature_ref":      { "type": "string" },
        "hto_id_regex":     { "type": "string", "minLength": 1 },
        "seurat_quantile":  { "type": "number", "default": 0.99, "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "demux_output":     { "type": "string" }
      },
      "allOf": [
        {
          "if": {"properties": {"demux_type": {"const": "hto" } } },
          "then": {
            "allOf": [
              { "required": ["feature_ref" ] },
              {
                "oneOf": [
                  { "required": ["fastq_dir"] },
                  { "required": ["arv_uuids"] }
                ]
              }
            ]
          },
         "else": {
            "not": { "required": ["feature_ref"] }
          }
        },
        {
          "if": {"properties": {"demux_type": {"const": "hto" } } },
          "else": { "not": { "required": ["hto_id_regex"] } }
        },
        {
          "if": {"properties": {"demux_type": {"const": "custom" } } },
          "then": {"required": ["demux_output" ] },
          "else": {
            "not": { "required": ["demux_output"] }
          }
        },
        {
          "if": {"properties": {"demux_type": {"enum": ["none", "flex", "ocm"] } } },
          "then": {
            "not": { "required": ["fastq_dir", "arv_uuids", "demux_output", "feature_ref"] }
          }
        }
      ]
    },
    "ambient": {
      "type": "object",
      "required": ["ambient_method"],
      "additionalProperties": false,
      "properties": {
        "ambient_method":               { "type": "string", "enum": ["decontx_background", "decontx_cluster", "cellbender", "none"], "default": "decontx_background" },
        "cell_calling":                 { "type": "string", "enum": ["barcodeRanks", "emptyDrops"], "default": "barcodeRanks" },
        "cb_version":                   { "type": "string", "enum": ["v0.3.2", "v0.3.0'", "v0.2.0'"], "default": "v0.3.2" },
        "cb_max_prop_kept":             { "type": "number", "default": 0.9 },
        "cb_learning_rate":             { "type": "number", "default": 1e-4 },
        "cb_posterior_batch_size":      { "type": "integer", "exclusiveMinimum": 0, "default": 128 },
        "cb_empty_training_fraction":   { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.2 },
        "cb_expected_cells":            { "type": "number" },
        "cb_total_droplets_included":   { "type": "number" },
        "cb_low_count_threshold":       { "type": "number" }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qc_min_counts":  { "type": "integer", "exclusiveMinimum": 0, "default": 500 },
        "qc_max_counts":  { "type": ["integer", "null"], "exclusiveMinimum": 0, "default": null },
        "qc_min_feats":   { "type": "integer", "exclusiveMinimum": 0, "default": 300 },
        "qc_max_feats":   { "type": ["integer", "null"], "exclusiveMinimum": 0, "default": null },
        "qc_min_mito":    { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "qc_max_mito":    { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 },
        "qc_min_splice":  { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "qc_max_splice":  { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "qc_min_cells":   { "type": "integer", "exclusiveMinimum": 0, "default": 100 },
        "dbl_min_feats":  { "type": "integer", "exclusiveMinimum": 0, "default": 100 },
        "dbl_min_counts": { "type": "integer", "minimum": 0, "default": 0 },
        "dbl_dbr_sd":     { "type": ["number", "null"], "minimum": 0, "default": null },
        "dbl_clusters":   { "type": ["boolean", "null"], "default": null },
        "exclude_mito":   { "type": "boolean", "default": true }
      }
    },
    "pb_empties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambient_genes_logfc_thr":  { "type": "number", "default": 0 },
        "ambient_genes_fdr_thr":    { "type": "number", "default": 0.01 }
      }
    },
    "hvg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hvg_method":                 { "type": "string", "enum": ["sample", "all", "groups"], "default": "sample" },
        "hvg_n_hvgs":                 { "type": "integer", "default": 2000 },
        "hvg_chunk_size":             { "type": "integer", "default": 2000 },
        "hvg_exclude_ambient_genes":  { "type": "boolean", "default": true },
        "hvg_exclude_from_file":      { "type": "string", "items": {"type": "string", "pattern": "^.+\\.csv$"} },
        "hvg_metadata_split_var":     { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {"properties": {"hvg_method": {"const": "groups" } } },
          "then": { "required": ["hvg_metadata_split_var" ] },
          "else": {
            "not": { "required": ["hvg_metadata_split_var"] }
          }
        }
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "int_pca_method":   { "type": "string",   "default": "bpcells", "enum": ["bpcells", "scanpy"] },
        "int_use_gpu":      { "type": "boolean",  "default": true },
        "int_embedding":    { "type": "string",   "default": "harmony", "enum": ["harmony", "pca"] },
        "int_cl_method":    { "type": "string",   "default": "leiden", "enum": ["leiden"] },
        "int_theta":        { "type": "number",   "default": 0.1 },
        "int_batch_var":    { "type": "string",   "default": "sample_id", "enum": ["pool_id", "sample_id"] },
        "int_n_dims":       { "type": "integer",  "default": 50 },
        "int_umap_n_iter": { "type": "integer", "minimum": 1, "default": 2000 },
        "int_dbl_res":      { "type": "number",   "default": 4 },
        "int_dbl_cl_prop":  { "type": "number", "minimum": 0, "maximum": 1 },
        "int_dbl_threshold_method": { "type": "string", "enum": ["adaptive", "manual"], "default": "adaptive" },
        "int_sce_outs":     { "type": "boolean",  "default": false},
        "int_use_paga":     { "type": "boolean",  "default": true},
        "int_paga_cl_res":  { "type": "number",   "default": 2, "exclusiveMinimum": 0},
        "int_cell_cycle_harmonics":    { "type": "integer", "enum": [1, 2], "default": 2, "x-default-requires": "int_cell_cycle_correction" },
        "int_cell_cycle_ridge_lambda": { "type": "number", "minimum": 0, "default": 0.1, "x-default-requires": "int_cell_cycle_correction" },
        "int_cell_cycle_correction": { "type": "string", "enum": ["within_sample", "global"] },
        "int_res_ls": {
          "type":     "array",
          "items":    { "type": "number" },
          "default":  [0.1, 0.2, 0.5, 1, 2]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"int_dbl_threshold_method": {"const": "adaptive"}}},
          "then": {"not": {"required": ["int_dbl_cl_prop"]}},
          "else": {"required": ["int_dbl_cl_prop"]}
        },
        {
          "if": {"properties": {"int_use_paga": {"const": true}}},
          "then": {
            "required": ["int_paga_cl_res"]
          },
          "else": {
            "not": {"required": ["int_paga_cl_res"]}
          }
        }
      ]
    },
    "cell_cycle": {
      "type": "object",
      "additionalProperties": false,
      "x-defaults-only-when-present": true,
      "required": ["cyc_density_percentile"],
      "properties": {
        "cyc_bandwidth_multiplier": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "cyc_kde_grid_size": { "type": "integer", "minimum": 20, "default": 500 },
        "cyc_density_percentile": { "type": "number", "minimum": 0, "maximum": 100, "examples": [1.3] },
        "cyc_density_percentile_grid": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 100 }, "uniqueItems": true, "default": [0, 0.1, 0.3, 1, 3, 10, 100] },
        "cyc_seed": { "type": "integer", "default": 20230308 },
        "cyc_origin_manual": {
          "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
        }
      }
    },
    "marker_genes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mkr_sel_res":      { "type": "number",   "default": 0.2 },
        "mkr_min_cl_size":  { "type": "integer",  "default": 100 },
        "mkr_min_cells":    { "type": "integer",  "default": 10 },
        "mkr_dispersion_use_clusters": { "type": "boolean", "default": true },
        "mkr_not_ok_re":    { "type": "string",   "default": "(lincRNA|lncRNA|pseudogene|antisense)" },
        "mkr_min_cpm_mkr":  { "type": "integer",  "default": 50 },
        "mkr_min_cpm_go":   { "type": "integer",  "default": 1 },
        "mkr_max_zero_p":   { "type": "number",   "default": 0.5 },
        "mkr_do_gsea":      { "type": "boolean",  "default": true }, 
        "mkr_gsea_var":     { "type": "string",   "default": "z_score", "enum": ["logFC", "z_score"] },
        "mkr_gsea_cut":     { "type": "number",   "default": 0.1 },
        "mkr_custom_genesets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^,]*$" },
              "file": { "type": "string" }
            }
          }
        }
      }
    },
    "label_celltypes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["labeller"],
        "properties": {
          "labeller":     { "type": "string", "enum": ["celltypist", "scprocess"] },
          "model":        { "type": "string" },
          "hi_res_cl":    { "type": "string", "default": "RNA_snn_res.2" },
          "min_cl_prop":  { "type": "number", "default": 0.5 },
          "min_cl_size":  { "type": "integer", "default": 100 },
          "label_map":    { "type": "string" },
          "save_cluster_names_file": { "type": "boolean", "default": false }
        },
        "allOf": [
          {
            "if": {"properties": {"labeller": { "enum": ["celltypist", "scprocess"] } } },
            "then": {
              "allOf": [
                { "required": ["model"] },
                {"not": { "required": ["custom_f"] }}
              ]
            }
          },
          {
            "if": {"properties": {"labeller": { "const": "custom" } } },
            "then": {
              "allOf": [
                { "required": ["custom_f"] },
                {"not": { "required": ["model"] }}
              ]
            }
          }
        ]
      }
    },
    "train_xgboost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annots_f"],
      "properties": {
        "annots_f": {"type": "string"},
        "label_specs_f": {"type": ["string", "null"], "default": null},
        "coarse_label_specs_f": {"type": ["string", "null"], "default": null},
        "min_cells_per_label": {"type": "integer", "minimum": 1, "default": 20},
        "min_cells_expressed": {"type": "integer", "minimum": 1, "default": 10},
        "gene_exclude_re": {"type": ["string", "null"], "default": "(lincRNA|lncRNA|pseudogene|antisense)"},
        "seed": {"type": "integer", "default": 42},
        "use_gpu": {"type": "boolean", "default": false},
        "pass1_subsample": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.632},
        "pass1_colsample_bytree": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.1},
        "pass1_learning_rate": {"type": "number", "exclusiveMinimum": 0, "default": 0.1},
        "pass1_nrounds": {"type": "integer", "minimum": 1, "default": 1000},
        "pass1_early_stopping": {"type": "integer", "minimum": 1, "default": 10},
        "pass2_colsample_bytree": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.5},
        "pass2_learning_rate": {"type": "number", "exclusiveMinimum": 0, "default": 0.05},
        "pass2_nrounds": {"type": "integer", "minimum": 1, "default": 2000},
        "pass2_early_stopping": {"type": "integer", "minimum": 1, "default": 10},
        "downsample_copies": {"type": "integer", "minimum": 0, "default": 0},
        "downsample_min_umis": {"type": "integer", "minimum": 1, "default": 300},
        "downsample_max_umis": {"type": "integer", "minimum": 2, "default": 3000},
        "gain_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.9},
        "min_genes": {"type": "integer", "minimum": 1, "default": 100},
        "max_genes": {"type": "integer", "minimum": 1, "default": 5000},
        "xgboost_tag": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
        "excluded_labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
        "cluster_majority_vote_resolution": {"type": "number", "exclusiveMinimum": 0},
        "cluster_majority_vote_min_purity": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.9},
        "test_group_var": {"type": "string", "minLength": 1},
        "test_groups": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "validation_group_var": {"type": "string", "minLength": 1, "default": "batch"},
        "validation_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.2},
        "validation_variable_combinations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
        "sampling_variable_combinations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
        "train_cells_per_label": {"type": "integer", "minimum": 1, "default": 2000},
        "validation_cells_per_label": {"type": "integer", "minimum": 1, "default": 500}
      },
      "allOf": [{"if": {"required": ["test_group_var"]}, "then": {"required": ["test_groups"]}}, {"if": {"required": ["test_groups"]}, "then": {"required": ["test_group_var"]}}]
    },
    "zoom": {
      "type": "array", "items": { "type": "string" }, "uniqueItems": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n_run_mapping":                 { "type": "integer", "default": 8},
        "n_run_mapping_flex":            { "type": "integer", "default": 8}, 
        "gb_build_hto_index":            { "type": "integer" },
        "gb_run_mapping":                { "type": "integer" },
        "gb_run_mapping_hto":            { "type": "integer" },
        "gb_run_mapping_flex":           { "type": "integer" },
        "gb_save_alevin_to_h5":          { "type": "integer" },
        "gb_make_hto_sce_objects":       { "type": "integer" },
        "gb_save_alevin_hto_to_h5":      { "type": "integer" },
        "gb_save_alevin_adt_to_h5":      { "type": "integer" },
        "mins_build_hto_index":           { "type": "integer" },
        "mins_run_mapping":               { "type": "integer" },
        "mins_run_mapping_hto":           { "type": "integer" },
        "mins_run_mapping_flex":          { "type": "integer" },
        "mins_save_alevin_to_h5":         { "type": "integer" },
        "mins_make_hto_sce_objects":      { "type": "integer" }, 
        "mins_save_alevin_hto_to_h5":     { "type": "integer" },
        "mins_save_alevin_adt_to_h5":     { "type": "integer" },

        "gb_run_cellbender":              { "type": "integer" },
        "gb_run_decontx":                 { "type": "integer" }, 
        "gb_run_cell_calling":            { "type": "integer" },
        "gb_get_barcode_qc_metrics":      { "type": "integer" },
        "mins_run_cellbender":            { "type": "integer" },
        "mins_run_decontx":               { "type": "integer" }, 
        "mins_run_cell_calling":          { "type": "integer" },
        "mins_get_barcode_qc_metrics":    { "type": "integer" },
        
        "gb_check_demux_ids":             { "type": "integer" },
        "mins_check_demux_ids":           { "type": "integer" },

        "gb_run_doublet_id_one_run":      { "type": "integer" },
        "gb_filter_qc_one_run":           { "type": "integer" },
        "gb_merge_doublet_diagnostics":   { "type": "integer" },
        "mins_merge_doublet_diagnostics": { "type": "integer" },
        "gb_merge_qc":                    { "type": "integer" },
        "gb_merge_rowdata":               { "type": "integer" },
        "gb_get_qc_sample_statistics":    { "type": "integer" },
        "mins_run_doublet_id_one_run":    { "type": "integer" },
        "mins_filter_qc_one_run":         { "type": "integer" },
        "mins_merge_qc":                  { "type": "integer" },
        "mins_merge_rowdata":             { "type": "integer" },
        "mins_get_qc_sample_statistics":  { "type": "integer" },

        "gb_make_one_pb_empty":          { "type": "integer" },
        "gb_merge_pb_empty":             { "type": "integer" },
        "gb_make_one_pb_cells":          { "type": "integer" },
        "gb_merge_pb_cells":             { "type": "integer" },
        "gb_calculate_ambient_genes":    { "type": "integer" },
        "mins_make_one_pb_empty":         { "type": "integer" },
        "mins_merge_pb_empty":            { "type": "integer" },
        "mins_make_one_pb_cells":         { "type": "integer" },
        "mins_merge_pb_cells":            { "type": "integer" },
        "mins_calculate_ambient_genes":   { "type": "integer" },

        "gb_make_tmp_csr_matrix":        { "type": "integer" },
        "gb_get_stats_for_std_variance_for_sample": { "type": "integer" },
        "gb_get_mean_var_for_group":     { "type": "integer" },
        "gb_get_estimated_variances":    { "type": "integer" },
        "gb_get_stats_for_std_variance_for_group": { "type": "integer" },
        "gb_get_highly_variable_genes":  { "type": "integer" },
        "gb_create_hvg_matrix":          { "type": "integer" },
        "gb_create_doublets_hvg_matrix": { "type": "integer" },
        "mins_make_tmp_csr_matrix":       { "type": "integer" },
        "mins_get_stats_for_std_variance_for_sample": { "type": "integer" },
        "mins_get_mean_var_for_group":    { "type": "integer" },
        "mins_get_estimated_variances":   { "type": "integer" },
        "mins_get_stats_for_std_variance_for_group": { "type": "integer" },
        "mins_get_highly_variable_genes": { "type": "integer" },
        "mins_create_hvg_matrix":         { "type": "integer" },
        "mins_create_doublets_hvg_matrix": { "type": "integer" },

        "gb_calculate_tricycle_projection_one_run":       { "type": "integer" },
        "mins_calculate_tricycle_projection_one_run":     { "type": "integer" },
        "gb_aggregate_tricycle":           { "type": "integer" },
        "mins_aggregate_tricycle":         { "type": "integer" },
        "gb_estimate_tricycle_reference_ellipse":   { "type": "integer" },
        "mins_estimate_tricycle_reference_ellipse": { "type": "integer" },

        "gb_run_integration":             { "type": "integer" },
        "gb_make_clean_h5ads":            { "type": "integer" },
        "gb_convert_h5ad_to_sce":         { "type": "integer" },
        "mins_run_integration":           { "type": "integer" },
        "mins_make_clean_h5ads":          { "type": "integer" },
        "mins_convert_h5ad_to_sce":       { "type": "integer" },

        "n_run_marker_genes": { "type": "integer", "minimum": 1, "default": 8 },
