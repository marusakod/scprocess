    "shiny": {
      "title": "Shiny App Configuration",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app_tag":      { "type": "string",  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "app_title":    { "type": "string" },
        "email":        { "type": "string" },
        "keyword":      { "type": "string", "default": "cells" },
        "default_gene": { "type": "string" },
        "n_keep":       { "type": "integer", "default": 30000, "exclusiveMinimum": 0 },
        "metadata_vars":  { "type": "array", "items": { "type": "string" } },
        "metadata_labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "metadata_combns":     { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 } },
        "home_md":          { "type": "string" },
        "annotation_csv":   { "type": "string" },
        "cluster_palette":  { "type": "string" },
        "metadata_palettes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "array",
                "items": { "type": "string" } },
              { "type": "object",
                "additionalProperties": false,
                "properties": {
                  "palette":  { "type": "string" },
                  "colours":  { "type": "array", "items": { "type": "string" } },
                  "values":   { "type": "array", "items": { "type": "string" } }
                }
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "comment": "If tenx_assay_type is flex AND multiplexing section is present, demux_type must be none or flex.",
      "if": {
        "required": ["project", "multiplexing"],
        "properties": {
          "project": { "properties": { "tenx_assay_type": { "const": "flex" } } }
        }
      },
      "then": {
        "properties": {
          "multiplexing": {
            "properties": {
              "demux_type": { "enum": ["none", "flex"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"integration": {
          "properties": {"int_batch_var": {"const": "pool_id" } }, "required": ["int_batch_var"] 
        } }, "required": ["integration"]
      },
      "then": {
        "properties": {"multiplexing": {
            "properties": {"demux_type": {"not": {"enum": ["none", "flex"] } } }, "required": ["demux_type"]
          }
        }, "required": ["multiplexing"]
      }
    },
    {
      "if": {
        "required": ["multiplexing"],
        "properties": {
          "multiplexing": { "required": ["arv_uuids"] }
        }
      },
      "then": {
        "required": ["project"],
        "properties": {
          "project": { "required": ["arv_instance"] }
        }
      }
    }
  ]
}
